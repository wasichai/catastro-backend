# Variables de ejemplo para desarrollar catastro-backend en local.
#
#   cp develop/example.env develop/.env      # develop/.env está en .gitignore: nunca se versiona
#   set -a; source develop/.env; set +a      # exporta las variables al shell actual
#   ./gradlew bootRun
#
# Guía completa: docs/develop/README.md

# --- Base de datos (compose.yml: postgis/postgis:18-3.6 en 127.0.0.1:5434, base/usuario/clave catastro) ---
WASICHAI_DB_HOST=localhost
WASICHAI_DB_PORT=5434
WASICHAI_DB_NAME=catastro
WASICHAI_DB_USERNAME=catastro
WASICHAI_DB_PASSWORD=catastro
# puerto que publica compose.yml (debe coincidir con WASICHAI_DB_PORT). nunca 5432 (otra app) ni 5433 (srtm)
CATASTRO_PG_PORT=5434

# --- Seguridad ---
# >= 32 bytes. solo para desarrollo: en cualquier entorno real, uno propio y secreto
WASICHAI_JWT_SECRET=catastro-dev-only-secret-change-me-0123456789
# crea admin@wasichai.local / admin. apagarlo (false) fuera de desarrollo
WASICHAI_SEED_DEV=true
# un usuario desactivado o un logout anulan los tokens ya emitidos. apagado en desarrollo, encendido en uno real
# WASICHAI_JWT_REVOCATION=true
# límite de intentos de login (429 al pasarlo). apagado en desarrollo, encendido en un despliegue real
# WASICHAI_LOGIN_LIMIT=true

# --- GIS. Sin GeoServer los lotes salen directo de PostGIS; solo publicar capas WMS lo necesita ---
# arranque (solo en tu máquina): docker compose -f compose.yml -f compose.geoserver.yml --profile geoserver-local up -d
# con la clave de abajo ya cargada. guía: docs/develop/README.md, sección 3.1
WASICHAI_GEOSERVER_ENABLED=true
# REST de GeoServer, tal como lo ve el servidor (geoserver-local lo publica en 127.0.0.1:8085)
WASICHAI_GEOSERVER_URL=http://localhost:8085/geoserver
# administrador de GeoServer. compose.geoserver.yml lo crea con estos valores; cambia la clave, no se versiona la real
WASICHAI_GEOSERVER_USERNAME=admin
WASICHAI_GEOSERVER_PASSWORD=<clave-de-geoserver>
# workspace donde se publican las capas (se crea solo)
WASICHAI_GEOSERVER_WORKSPACE=catastro
# puerto que publica geoserver-local (compose.geoserver.yml), solo desarrollo
CATASTRO_GEOSERVER_PORT=8085
# cómo llega GeoServer a PostGIS, visto desde GeoServer: el servicio `postgres` de compose, puerto interno 5432
WASICHAI_GEOSERVER_DS_HOST=postgres
WASICHAI_GEOSERVER_DS_PORT=5432
WASICHAI_GEOSERVER_DS_DATABASE=catastro
WASICHAI_GEOSERVER_DS_USERNAME=catastro
WASICHAI_GEOSERVER_DS_PASSWORD=catastro

# --- Scripts de model/ (apply.py, apply_roles.py, configurar_region.py, crear_cuenta_srtm.py, import_*.py) ---
WASICHAI_CORE=http://localhost:8091
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- GitHub Packages (librerías wasichai). Opcional si ya están en ~/.gradle/gradle.properties (gpr.user/gpr.key) ---
# GITHUB_ACTOR=<usuario de github>
# GITHUB_TOKEN=<PAT con read:packages>

# --- Tests de integración contra una base externa (solo con Docker remoto). El nombre debe terminar en _test ---
# WASICHAI_TEST_DB_HOST=localhost
# WASICHAI_TEST_DB_PORT=5444
# WASICHAI_TEST_DB_NAME=catastro_test
# WASICHAI_TEST_DB_USERNAME=catastro
# WASICHAI_TEST_DB_PASSWORD=<clave>
